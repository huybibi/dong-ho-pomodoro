{
  "name": "dong-ho-pomodoro",
  "productName": "Đồng hồ Pomodoro",
  "version": "1.0.0",
  "description": "Đồng hồ Pomodoro hỗ trợ phiên làm việc sâu (deep work): đếm ngược always-on-top, hít thở tập trung, thống kê chuỗi ngày.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron tools/make-icons.js",
    "smoke": "set DEEPWORK_SMOKE=1&& electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.pomodoro",
    "productName": "Pomodoro",
    "files": [
      "main.js",
      "preload.js",
      "patterns.js",
      "store.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pomodoro"
    }
  }
}
